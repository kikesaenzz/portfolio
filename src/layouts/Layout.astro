---
import '../styles/global.css';
interface Props { title: string; description?: string; }
const { title, description = "Desarrollador de software especializado en datos, automatización y QA." } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <script is:inline>
      (function () {
        var THEMES = {
          light: { bg:'#F7F6F3', bgAlt:'#EFEDE7', ink:'#16181B', inkSoft:'#52565C', line:'#DAD7CE', accent:'#2B3A55', accent2:'#8A6E4B', accentSoft:'#DCE2ED', paper:'#FFFFFF' },
          dark:  { bg:'#14161A', bgAlt:'#1B1E24', ink:'#F3F1EB', inkSoft:'#9DA1A8', line:'#2C2F36', accent:'#8FA6D1', accent2:'#D4B888', accentSoft:'#212B3D', paper:'#1A1D23' }
        };
        window.__applyTheme = function (name) {
          var t = THEMES[name] || THEMES.light;
          var s = document.documentElement.style;
          s.setProperty('--bg', t.bg);
          s.setProperty('--bg-alt', t.bgAlt);
          s.setProperty('--ink', t.ink);
          s.setProperty('--ink-soft', t.inkSoft);
          s.setProperty('--line', t.line);
          s.setProperty('--accent', t.accent);
          s.setProperty('--accent-2', t.accent2);
          s.setProperty('--accent-soft', t.accentSoft);
          s.setProperty('--paper', t.paper);
          document.documentElement.setAttribute('data-theme', name);
        };
        var stored = null;
        try { stored = localStorage.getItem('theme'); } catch (e) {}
        var theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        window.__applyTheme(theme);
      })();
    </script>
  </head>
  <body>
    <div class="cursor-ring" aria-hidden="true"></div>
    <div class="cursor-dot" aria-hidden="true"></div>
    <slot />
    <script is:inline>
      (function () {
        // Custom cursor: move the dot/ring elements directly (no CSS var indirection)
        const isTouchDevice = window.matchMedia('(hover: none), (pointer: coarse)').matches;
        if (!isTouchDevice) {
          const dot = document.querySelector('.cursor-dot');
          const ring = document.querySelector('.cursor-ring');
          let shown = false;
          function moveCursor(x, y) {
            if (!shown) { shown = true; dot.style.opacity = '1'; ring.style.opacity = '.55'; }
            dot.style.transform = `translate3d(${x - 5}px, ${y - 5}px, 0)`;
            ring.style.transform = `translate3d(${x - 17}px, ${y - 17}px, 0)`;
          }
          window.addEventListener('pointermove', (e) => moveCursor(e.clientX, e.clientY));
          window.addEventListener('mousemove', (e) => moveCursor(e.clientX, e.clientY));
          document.body.classList.add('has-custom-cursor');
          document.querySelectorAll('a, button, .card, .skill-tags span').forEach((el) => {
            el.addEventListener('mouseenter', () => document.body.classList.add('cursor-active'));
            el.addEventListener('mouseleave', () => document.body.classList.remove('cursor-active'));
          });
        }

        // Theme toggle
        const themeBtn = document.getElementById('theme-toggle');
        if (themeBtn) {
          themeBtn.addEventListener('click', () => {
            const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
            window.__applyTheme(next);
            try { localStorage.setItem('theme', next); } catch (e) {}
          });
        }
      })();
    </script>
  </body>
</html>
