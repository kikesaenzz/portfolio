---
import '../styles/global.css';

interface Props { title: string; description?: string; }
const {
  title,
  description = 'Enrique Sáenz de Urturi, desarrollador de software en Zaragoza. Backend con PHP y Laravel, datos con Node.js, automatización con Python e IA aplicada con Power Platform y Azure.',
} = Astro.props;
---
<!doctype html>
<html lang="es" class="is-loading">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=Instrument+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <!-- Tema antes del primer pintado: claro por defecto, oscuro si lo eligió -->
    <script is:inline>
      (function () {
        var t = 'light';
        try { t = localStorage.getItem('theme') || 'light'; } catch (e) {}
        document.documentElement.setAttribute('data-theme', t === 'dark' ? 'dark' : 'light');
      })();
    </script>
    <noscript><style>#loader{display:none!important}html.is-loading{overflow:auto!important}</style></noscript>
  </head>
  <body>
    <!-- Pantalla de carga: un mini pipeline. Los paquetes pasan por Datos, API, Automatización e IA
         mientras el nombre "se compila". Al llegar al 100 % un círculo naranja abre la página. -->
    <div id="loader" class="loader" role="status" aria-live="polite" aria-label="Cargando el portfolio">
      <div class="ld-inner">
        <div class="ld-name" aria-hidden="true">
          <div class="ld-title" id="ld-title" data-text="Enrique Sáenz de Urturi">Enrique Sáenz de Urturi</div>
          <p class="ld-role">Backend · Datos · Automatización · IA</p>
        </div>
        <div class="ld-flow" aria-hidden="true">
          <div class="ld-line"><i id="ld-fill"></i></div>
          <ol class="ld-nodes">
            <li class="ld-node"><span class="dot"></span><span class="lbl">Datos</span></li>
            <li class="ld-node"><span class="dot"></span><span class="lbl">API</span></li>
            <li class="ld-node"><span class="dot"></span><span class="lbl">Automatiza</span></li>
            <li class="ld-node"><span class="dot"></span><span class="lbl">IA</span></li>
          </ol>
          <div class="ld-packets" id="ld-packets"></div>
        </div>
        <div class="ld-status">
          <span id="ld-msg">Leyendo datos</span>
          <span><b id="ld-pct">0</b> %</span>
        </div>
      </div>
      <div class="ld-wipe" id="ld-wipe"></div>
    </div>

    <slot />

    <!-- Red de seguridad: si el JS principal no arranca, el loader no bloquea la página -->
    <script is:inline>
      setTimeout(function () {
        var l = document.getElementById('loader');
        if (l && !window.__appReady) {
          l.parentNode && l.parentNode.removeChild(l);
          document.documentElement.classList.remove('is-loading');
        }
      }, 15000);
    </script>
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
