---
import '../styles/global.css';
interface Props { title: string; description?: string; }
const { title, description = "Enrique Sáenz de Urturi — desarrollador de software en Zaragoza. Datos, automatización y calidad, contadas cerca." } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,450;0,9..144,600;0,9..144,700;1,9..144,500&family=Figtree:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline>
      (function () {
        var THEMES = {
          light: { bg:'#FBF3E9', bgAlt:'#F3E1C8', ink:'#2B1D14', inkSoft:'#6E5A48', line:'#E7D3B4', accent:'#C6602E', accent2:'#B98A2E', accentSoft:'#F3DCC0', paper:'#FFFCF7' },
          dark:  { bg:'#20160F', bgAlt:'#2A1D14', ink:'#F6E9D8', inkSoft:'#C7AC90', line:'#3C2B1E', accent:'#E58A54', accent2:'#E4BB6B', accentSoft:'#3C291B', paper:'#271A11' }
        };
        window.__applyTheme = function (name) {
          var t = THEMES[name] || THEMES.light;
          var s = document.documentElement.style;
          s.setProperty('--bg', t.bg);
          s.setProperty('--bg-alt', t.bgAlt);
          s.setProperty('--ink', t.ink);
          s.setProperty('--ink-soft', t.inkSoft);
          s.setProperty('--line', t.line);
          s.setProperty('--accent', t.accent);
          s.setProperty('--accent-2', t.accent2);
          s.setProperty('--accent-soft', t.accentSoft);
          s.setProperty('--paper', t.paper);
          document.documentElement.setAttribute('data-theme', name);
        };
        var stored = null;
        try { stored = localStorage.getItem('theme'); } catch (e) {}
        var theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        window.__applyTheme(theme);
      })();
    </script>
  </head>
  <body>
    <slot />
    <script is:inline>
      (function () {
        var themeBtn = document.getElementById('theme-toggle');
        if (themeBtn) {
          themeBtn.addEventListener('click', function () {
            var next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
            window.__applyTheme(next);
            try { localStorage.setItem('theme', next); } catch (e) {}
          });
        }
      })();
    </script>
  </body>
</html>
