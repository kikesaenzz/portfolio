---
import '../styles/global.css';
interface Props { title: string; description?: string; }
const { title, description = "Enrique Sáenz de Urturi — desarrollador de software en Zaragoza. Datos, automatización y calidad, contadas cerca." } = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,450;0,9..144,600;0,9..144,700;1,9..144,500;1,9..144,700&family=Figtree:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline>
      (function () {
        var THEMES = {
          light: { bg:'#FBF3E9', bgAlt:'#F3E1C8', ink:'#2B1D14', inkSoft:'#6E5A48', line:'#E7D3B4', accent:'#C6602E', accent2:'#B98A2E', accentSoft:'#F3DCC0', paper:'#FFFCF7' },
          dark:  { bg:'#20160F', bgAlt:'#2A1D14', ink:'#F6E9D8', inkSoft:'#C7AC90', line:'#3C2B1E', accent:'#E58A54', accent2:'#E4BB6B', accentSoft:'#3C291B', paper:'#271A11' }
        };
        window.__applyTheme = function (name) {
          var t = THEMES[name] || THEMES.light;
          var s = document.documentElement.style;
          s.setProperty('--bg', t.bg);
          s.setProperty('--bg-alt', t.bgAlt);
          s.setProperty('--ink', t.ink);
          s.setProperty('--ink-soft', t.inkSoft);
          s.setProperty('--line', t.line);
          s.setProperty('--accent', t.accent);
          s.setProperty('--accent-2', t.accent2);
          s.setProperty('--accent-soft', t.accentSoft);
          s.setProperty('--paper', t.paper);
          document.documentElement.setAttribute('data-theme', name);
        };
        var stored = null;
        try { stored = localStorage.getItem('theme'); } catch (e) {}
        var theme = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        window.__applyTheme(theme);
      })();
    </script>
  </head>
  <body>
    <div class="cursor-glow" aria-hidden="true"></div>
    <div class="cursor-ring" aria-hidden="true"></div>
    <div class="cursor-dot" aria-hidden="true"></div>
    <slot />
    <script is:inline>
      (function () {
        var themeBtn = document.getElementById('theme-toggle');
        if (themeBtn) {
          themeBtn.addEventListener('click', function () {
            var next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
            window.__applyTheme(next);
            try { localStorage.setItem('theme', next); } catch (e) {}
          });
        }

        // Custom cursor
        var isTouchDevice = window.matchMedia('(hover: none), (pointer: coarse)').matches;
        var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!isTouchDevice) {
          var dot = document.querySelector('.cursor-dot');
          var ring = document.querySelector('.cursor-ring');
          var glow = document.querySelector('.cursor-glow');
          var shown = false;
          function moveCursor(x, y) {
            if (!shown) { shown = true; dot.style.opacity = '1'; ring.style.opacity = '1'; if (glow) glow.style.opacity = '1'; }
            dot.style.transform = 'translate3d(' + (x - 5) + 'px, ' + (y - 5) + 'px, 0)';
            ring.style.transform = 'translate3d(' + (x - 17) + 'px, ' + (y - 17) + 'px, 0)';
          }
          window.addEventListener('pointermove', function (e) { moveCursor(e.clientX, e.clientY); });

          // Glow trails a little behind for a soft, ambient feel
          if (glow && !reduceMotion) {
            var gx = -9999, gy = -9999, tx = -9999, ty = -9999;
            window.addEventListener('pointermove', function (e) { tx = e.clientX; ty = e.clientY; });
            (function glowLoop() {
              gx += (tx - gx) * 0.08;
              gy += (ty - gy) * 0.08;
              glow.style.transform = 'translate3d(' + (gx - 230) + 'px, ' + (gy - 230) + 'px, 0)';
              requestAnimationFrame(glowLoop);
            })();
          } else if (glow) {
            window.addEventListener('pointermove', function (e) {
              glow.style.transform = 'translate3d(' + (e.clientX - 230) + 'px, ' + (e.clientY - 230) + 'px, 0)';
            });
          }
          document.body.classList.add('has-custom-cursor');
          function bindHoverTargets() {
            document.querySelectorAll('a, button, .card, .skill-tags span').forEach(function (el) {
              if (el.__cursorBound) return;
              el.__cursorBound = true;
              el.addEventListener('mouseenter', function () { document.body.classList.add('cursor-active'); });
              el.addEventListener('mouseleave', function () { document.body.classList.remove('cursor-active'); });
            });
          }
          bindHoverTargets();
          new MutationObserver(bindHoverTargets).observe(document.body, { childList: true, subtree: true });
        }
      })();
    </script>
  </body>
</html>
