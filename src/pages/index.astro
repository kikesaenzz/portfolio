---
import Layout from '../layouts/Layout.astro';
import { profile, summary, sections, facts, capabilities, jobs, cases, works, stack, education } from '../data/profile';
---
<Layout title="Enrique Sáenz de Urturi · Desarrollador backend en la Administración Pública">
  <div class="progress" aria-hidden="true"></div>

  <a class="brandmark" href="#perfil" data-nav>
    <span class="sq" aria-hidden="true"></span>
    <span><b>{profile.name}</b><small>Zaragoza · disponible</small></span>
  </a>

  <div class="tools">
    <button class="pill" id="index-open" aria-haspopup="dialog" aria-controls="index">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true"><rect x="0" y="1" width="14" height="2" rx="1"/><rect x="0" y="6" width="10" height="2" rx="1"/><rect x="0" y="11" width="6" height="2" rx="1"/></svg>
      Índice
    </button>
    <a class="pill txt-cv" href={profile.cvPdf} download>CV <span aria-hidden="true">↓</span></a>
    <button class="pill icon" id="theme-toggle" aria-label="Cambiar entre modo claro y oscuro">
      <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5Z"/></svg>
    </button>
  </div>

  <!-- Hilo de flujo: dónde estás y qué viene -->
  <nav class="rail" aria-label="Secciones">
    <div class="rail-track"><i class="rail-fill"></i></div>
    <ol>
      {sections.map((s) => (
        <li data-for={s.id}><a href={`#${s.id}`} data-nav><span class="nd"></span><span class="tx">{s.n} {s.label}</span></a></li>
      ))}
    </ol>
  </nav>

  <!-- Índice a pantalla completa -->
  <div class="index" id="index" role="dialog" aria-modal="true" aria-label="Índice del portfolio">
    <div class="index-inner">
      <div class="index-top"><span>Índice · de mayor a menor importancia</span><button class="pill" id="index-close">Cerrar <span aria-hidden="true">✕</span></button></div>
      <ol>
        {sections.map((s) => (
          <li><a href={`#${s.id}`} data-nav data-close><span class="n">{s.n}</span><span class="t">{s.label}</span><span class="b">{s.blurb}</span></a></li>
        ))}
      </ol>
    </div>
  </div>

  <main>
    <!-- 01 PERFIL -->
    <section id="perfil" class="perfil" style="padding:0">
      <div class="hero">
        <div class="prism" aria-hidden="true"><div class="prism-plane" id="prism"></div></div>
        <div class="wrap">
          <p class="eyebrow" data-intro><span class="pulse" aria-hidden="true"></span>Desarrollador backend · Zaragoza</p>
          <h1 class="h1" id="hero-title">
            <span class="ln">Backend <em>Java y PHP</em>,</span>
            <span class="ln">trámites <em>automatizados</em>,</span>
            <span class="ln"><em>Administración Pública</em>.</span>
          </h1>
          <p class="hero-sub" data-intro>Soy <strong>{profile.name}</strong>. Desarrollo y mantengo aplicaciones para ministerios y otras administraciones con Java, Spring Boot y PHP, y automatizo trámites con Python, Power Platform y Azure.</p>
          <div class="cta-row" data-intro>
            <a class="btn primary magnetic" href="#hacer" data-nav>Ver mi trabajo</a>
            <a class="btn ghost magnetic" href={profile.cvPdf} download>Descargar CV</a>
            <a class="btn ghost magnetic" href={`mailto:${profile.email}`}>Escribirme</a>
          </div>
          <dl class="facts" data-intro>
            {facts.map((f) => (
              <div><dt>{f.k}</dt><dd>{f.v}<small>{f.s}</small></dd></div>
            ))}
          </dl>
        </div>
        <div class="scroll-cue" aria-hidden="true"><i></i>Desliza</div>
      </div>

      <div class="statement-sec">
        <div class="wrap">
          <p class="kicker"><b>01</b> Perfil</p>
          <p class="statement" id="statement">{summary}</p>
        </div>
      </div>
    </section>

    <!-- 02 QUÉ HAGO -->
    <section id="hacer" class="cap">
      <div class="cap-pin">
        <div class="wrap cap-grid">
          <div>
            <p class="kicker"><b>02</b> Qué hago</p>
            <h2 data-split>Cuatro áreas, de más a menos peso.</h2>
            <ol class="cap-list">
              {capabilities.map((c, i) => (
                <li><button class={`cap-item${i === 0 ? ' is-active' : ''}`} data-i={i}><span class="n">0{i + 1}</span>{c.t}</button></li>
              ))}
            </ol>
          </div>
          <div class="cap-panels">
            <div class="cap-bar" aria-hidden="true"><i></i></div>
            {capabilities.map((c, i) => (
              <article class="cap-panel" data-i={i}>
                <p class="num">Área 0{i + 1} de 0{capabilities.length}</p>
                <h3>{c.t}</h3>
                <p>{c.d}</p>
                <ul class="chips">{c.chips.map((x) => <li class="chip">{x}</li>)}</ul>
                <h4>Dónde lo he hecho</h4>
                <ul class="seen">{c.seen.map((x) => <li>{x}</li>)}</ul>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 03 EXPERIENCIA -->
    <section id="experiencia">
      <div class="wrap">
        <div class="sec-head">
          <p class="kicker"><b>03</b> Experiencia</p>
          <h2 data-split>Dónde he trabajado.</h2>
        </div>
        <div class="jobs">
          {jobs.map((j) => (
            <article class="job" data-fade>
              <div class="job-meta">{j.period}{j.current && <><br /><span class="now">En activo</span></>}</div>
              <div>
                <h3>{j.role}</h3>
                <p class="org">{j.org}</p>
                {j.intro && <p class="in">{j.intro}</p>}
                <ul>{j.bullets.map((b) => <li>{b}</li>)}</ul>
                {j.tech.length > 0 && (<><h4>{j.techTitle}</h4><ul>{j.tech.map((t) => <li>{t}</li>)}</ul></>)}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 04 CASOS -->
    <section id="casos" class="casos">
      <div class="casos-pin">
        <div class="wrap sec-head" style="width:100%">
          <p class="kicker"><b>04</b> Casos</p>
          <h2 data-split>Proyectos para ministerios y clientes.</h2>
          <p class="casos-hint">Sigue deslizando para recorrerlos</p>
        </div>
        <div class="casos-track">
          {cases.map((c, i) => (
            <article class={`case${i === 0 ? ' first' : ''}`}>
              <p class="client">{c.client} · {c.period}</p>
              <h3>{c.title}</h3>
              <p class="role">{c.role}</p>
              <ul class="bl">{c.bullets.map((b) => <li>{b}</li>)}</ul>
              <ul class="chips">{c.stack.map((s) => <li class="chip">{s}</li>)}</ul>
            </article>
          ))}
        </div>
        <div class="wrap" style="width:100%"><div class="casos-bar" aria-hidden="true"><i></i></div></div>
      </div>
    </section>

    <!-- 05 PROYECTOS PROPIOS -->
    <section id="proyectos">
      <div class="wrap">
        <div class="sec-head">
          <p class="kicker"><b>05</b> Proyectos propios</p>
          <h2 data-split>Webs que siguen en línea.</h2>
          <p class="lead" data-fade>Integración de servicios, datos y automatización aplicados a casos reales, del formulario al despliegue.</p>
        </div>
        <div class="works">
          {works.map((w, i) => (
            <article class="work" style={`--i:${i}`}>
              <div class="work-media"><img src={w.img} alt={w.alt} width="1000" height="625" loading="lazy" decoding="async" /></div>
              <div class="work-body">
                <p class="tag">{w.tag}</p>
                <h3>{w.title}</h3>
                <p class="desc">{w.desc}</p>
                <ul class="chips">{w.stack.map((s) => <li class="chip">{s}</li>)}</ul>
                <div class="links">
                  <a class="link solid" href={w.live} target="_blank" rel="noopener noreferrer">Ver en vivo <span aria-hidden="true">↗</span></a>
                  {w.repo && <a class="link" href={w.repo} target="_blank" rel="noopener noreferrer">Código en GitHub</a>}
                </div>
                {w.note && <p class="note">{w.note}</p>}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- 06 STACK -->
    <section id="stack">
      <div class="wrap">
        <div class="sec-head">
          <p class="kicker"><b>06</b> Stack</p>
          <h2 data-split>Con qué trabajo.</h2>
        </div>
        <div class="stack-grid">
          {stack.map((g) => (
            <div class="stack-g">
              <h3>{g.t}</h3>
              <ul class="chips">{g.c.map((c) => <li class="chip">{c}</li>)}</ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 07 FORMACIÓN -->
    <section id="formacion">
      <div class="wrap">
        <div class="sec-head">
          <p class="kicker"><b>07</b> Formación</p>
          <h2 data-split>Lo que he estudiado.</h2>
        </div>
        <div class="edu">
          <div data-fade>
            <h3>Titulación académica</h3>
            {education.degrees.map((d) => (
              <div class="edu-i"><p class="t">{d.t}</p><p class="s">{d.s}<b>{d.d}</b></p></div>
            ))}
          </div>
          <div data-fade>
            <h3>Formación complementaria</h3>
            {education.courses.map((d) => (
              <div class="edu-i"><p class="t">{d.t}</p><p class="s">{d.s}{d.d && <b>{d.d}</b>}</p></div>
            ))}
            <div class="edu-i"><p class="t">Certificación de Microsoft Azure</p><span class="live">{education.inProgress}</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- 08 CONTACTO -->
    <section id="contacto" class="contact">
      <div class="wrap">
        <p class="kicker"><b>08</b> Contacto</p>
        <h2 data-split>Hablemos.</h2>
        <a class="mail" id="mail" href={`mailto:${profile.email}`} data-fade>{profile.email}</a>
        <div class="contact-row" data-fade>
          <button class="btn primary magnetic" id="copy-mail" type="button">Copiar email</button>
          <a class="btn ghost magnetic" href={profile.cvPdf} download>Descargar CV en PDF</a>
        </div>
        <div class="contact-meta" data-fade>
          <div><small>Teléfono</small><a href={profile.phoneHref}>{profile.phone}</a></div>
          <div><small>Ubicación</small>{profile.city}</div>
          <div><small>Disponibilidad</small>Total, con carné de conducir</div>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <div class="wrap"><span>{profile.name} · © 2026</span><span>Hecho con Astro y GSAP</span></div>
  </footer>
</Layout>
